{
  "include": ["client/src/**/*", "shared/**/*", "server/**/*", "programs/**/*", "tests/**/*"],
  "exclude": ["node_modules", "build", "dist", "**/*.test.js"],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",

    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2020",
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",

    "paths": {
      "@/*": ["./client/src/*"],
      "@shared/*": ["./shared/*"]
    },

    "types": ["node", "vite/client", "mocha", "chai"],
    "typeRoots": ["./node_modules/@types"]
  }
}
